#include <winver.h>

1 VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "SubController-LLC\0"
            VALUE "FileDescription", "Local realtime voice changer\0"
            VALUE "FileVersion", "0.3.0\0"
            VALUE "InternalName", "LocalVoiceChanger\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 SubController-LLC\0"
            VALUE "OriginalFilename", "LocalVoiceChanger.exe\0"
            VALUE "ProductName", "Local Voice Changer\0"
            VALUE "ProductVersion", "0.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END
